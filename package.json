{
  "name": "jev-decision-lab",
  "version": "0.1.0",
  "private": true,
  "description": "An educational lab for understanding where TypeSafe Jev (a decision model) fits between deterministic code and general-purpose LLMs.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "bench": "tsx experiments/benchmark.ts",
    "bench:all": "tsx experiments/benchmark.ts --experiment all",
    "calibration": "tsx experiments/calibration.ts",
    "latency": "tsx experiments/latency.ts",
    "cost": "tsx experiments/cost.ts"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dotenv": "^16.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  }
}
