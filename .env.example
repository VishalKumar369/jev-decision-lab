# ---------------------------------------------------------------------------
# jev-decision-lab environment
#
# Copy to `.env.local` (Next.js) — the benchmark scripts also load `.env.local`
# and `.env`. Every key is optional: with no keys at all the lab runs against
# the built-in `mock` provider, which is a deterministic heuristic, NOT a model.
# It exists so you can explore the pipeline shape before spending money.
#
# Never put API keys in frontend code or commit them to git.
# ---------------------------------------------------------------------------

# --- TypeSafe Jev, called directly (the primary provider) -------------------
# Get a key at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
# Pin a snapshot for reproducible benchmarks, or use the alias `jev-latest`.
TYPESAFE_MODEL=jev-latest
# Override only if TypeSafe changes hosts.
TYPESAFE_BASE_URL=https://api.typesafe.ai

# --- OpenRouter (optional) --------------------------------------------------
# Used for Claude + Gemini comparison arms on Support (same typed questions as Jev).
OPENROUTER_API_KEY=
OPENROUTER_JEV_MODEL=typesafe/jev-1.13
OPENROUTER_LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_CLAUDE_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_GEMINI_MODEL=google/gemini-2.5-flash

# --- Vercel AI Gateway (optional) -------------------------------------------
AI_GATEWAY_API_KEY=

# --- Standard LLM providers (optional; unused when comparing via OpenRouter) -
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# --- Lab behaviour ----------------------------------------------------------
DEFAULT_PROVIDER=jev
# Providers the UI may call.
ENABLED_PROVIDERS=mock,jev,openrouter-claude,openrouter-gemini
# Support Pipeline fires these in parallel on every Run.
SUPPORT_COMPARE_PROVIDERS=jev,openrouter-claude,openrouter-gemini
UI_RATE_LIMIT_PER_MINUTE=60
