# ---------------------------------------------------------------------------
# jev-decision-lab environment
#
# Copy to `.env.local` (Next.js) — the benchmark scripts also load `.env.local`
# and `.env`. Every key is optional: with no keys at all the lab runs against
# the built-in `mock` provider, which is a deterministic heuristic, NOT a model.
# It exists so you can explore the pipeline shape before spending money.
# ---------------------------------------------------------------------------

# --- TypeSafe Jev, called directly (the primary provider) -------------------
# Get a key at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
# Pin a snapshot for reproducible benchmarks, or use the alias `jev-latest`.
TYPESAFE_MODEL=jev-latest
# Override only if TypeSafe changes hosts.
TYPESAFE_BASE_URL=https://api.typesafe.ai

# --- OpenRouter (optional) --------------------------------------------------
# Used two ways:
#   1. `openrouter-jev`  → Jev via OpenRouter's decisions endpoint
#   2. `openrouter-llm`  → any chat model via OpenRouter, used as a *decision
#      emulator* (we ask the LLM to answer the same typed questions as JSON)
OPENROUTER_API_KEY=
OPENROUTER_JEV_MODEL=typesafe/jev-1.13
OPENROUTER_LLM_MODEL=openai/gpt-4o-mini

# --- Vercel AI Gateway (optional) -------------------------------------------
# Jev via Vercel's evaluation-model endpoint.
AI_GATEWAY_API_KEY=

# --- Standard LLM providers (optional) --------------------------------------
# These are the "general-purpose LLM" comparison arms. Each is asked to answer
# the same typed questions and return JSON with probabilities.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# --- Lab behaviour ----------------------------------------------------------
# Default provider for the UI and scripts when none is selected.
DEFAULT_PROVIDER=mock
# Comma-separated list of providers the UI is allowed to call. Prevents an
# accidental click from spending money on an expensive model.
ENABLED_PROVIDERS=mock,jev,openrouter-jev,openrouter-llm,openai,anthropic,google,vercel-jev
# Hard cap on requests a single UI session may issue per minute (deterministic
# policy — see lib/policy-engine.ts).
UI_RATE_LIMIT_PER_MINUTE=60
